# Public origin of the deployment. Used to build absolute share + OG URLs.
# Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically, so this is optional there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Enables the /s/<id> share page with a real OG image preview on X.
# Create a Blob store in the Vercel dashboard, then pull the token with `vercel env pull`.
# Without this the app still works: Share to X falls back to the native share sheet
# on mobile and to download + pre-filled composer on desktop.
BLOB_READ_WRITE_TOKEN=
